{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "root": {
      "type": "object",
      "patternProperties": {
        "^[A-Z]+$": {
          "type": "object",
          "properties": {
            "client_id": { "type": "integer" },
            "maxloss": { "type": "number" },
            "numshares": { "type": "integer" },
            "upPctMilestone": {
              "type": "array",
              "items": { "type": "number" }
            },
            "stopLossPct": {
              "type": "array",
              "items": { "type": "number" }
            },
            "name": { "type": "string" },
            "type": { "type": "string" },
            "symbol": { "type": "string" },
            "exchange": { "type": "string" },
            "currency": { "type": "string" }
          },
          "required": ["client_id", "maxloss", "numshares", "upPctMilestone", "stopLossPct", "name", "type", "symbol", "exchange", "currency"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["root"]
}
