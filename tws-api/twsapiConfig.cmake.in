# Contains path to twsapi shared object and include directories
get_filename_component(TWSAPI_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
set(TWSAPI_INCLUDE_DIRS "@CONF_INCLUDE_DIRS@")

#if(NOT TARGET foo AND NOT FooBar_BINARY_DIR)
